# Thư mục Hugo tự sinh khi build, không đưa vào repo
/public/
/resources/_gen/
.hugo_build.lock

# Hệ điều hành và editor
.DS_Store
.vscode/
.idea/

# Node (Pagefind, Decap CMS server chạy ở local)
node_modules/

# Chỉ mục tìm kiếm cho hugo server ở máy, do tools/dev.sh sinh ra
static/pagefind/

# Python venv cho các script font và brand: tạo bằng
#   python3 -m venv .venv && ./.venv/bin/pip install "fonttools[woff]" brotli numpy pillow
.venv/

# Font gốc rất nặng (Shippori Mincho B1 gần 15 MB) nên không commit.
# Tải lại bằng: python3 tools/fonts/get-sources.py
tools/fonts/src/

# File font đã subset: sinh ra từ nội dung, không commit.
# Dựng lại bằng: python3 tools/fonts/build.py --dev
assets/fonts/*.woff2

# Bản brief cá nhân: repo này sẽ là public, nên không đẩy file này lên
Yêu cầu.md
